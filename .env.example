# GSCRM - Environment Variables (Production)
# Bu dosyayı .env olarak kopyalayıp gerçek değerleri doldur.
# .env dosyası git'e commit EDİLMEZ (.gitignore'da).

# ───────────────────── Database ─────────────────────
# Compose içindeki postgres service'ine bağlanıyoruz (host=db).
DB_PASSWORD=change-me-strong-random-password

# Spring datasource (compose tarafından app'e geçilir)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/gscrm
SPRING_DATASOURCE_USERNAME=gscrm
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# ───────────────────── JWT ─────────────────────
# En az 256-bit (32+ byte) rastgele bir secret.
# Üretmek için: openssl rand -base64 48
# UYARI: prod'da repo'daki dev secret tespit edilirse uygulama başlamaz (fail-fast).
JWT_SECRET=change-me-min-256-bit-random-secret
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ───────────────────── Encryption (at-rest secrets) ─────────────────────
# Depoda şifreli tutulan sırlar bu anahtarla korunur. JWT_SECRET'tan FARKLI olmalı;
# aksi halde JWT rotasyonu tüm şifreli sırları çözülemez yapar.
# Üretmek için: openssl rand -base64 48
APP_ENCRYPTION_KEY=change-me-independent-256-bit-random-key

# ───────────────────── Genel adres ─────────────────────
# Uygulamanın dışarıdan görünen adresi. Kiracı çözümlemesinde KULLANILMAZ —
# tek domain + yol tabanlı kiracılık var (/{slug}). Yalnızca paylaşılabilir
# link üretir: davet linki ve işletmenin randevu linki.
APP_PUBLIC_BASE_URL=https://gserp.avesitesi.xyz

# ───────────────────── CORS ─────────────────────
# Virgülle ayrılmış izinli origin listesi. Wildcard kullanma.
APP_CORS_ALLOWED_ORIGINS=https://gscrm.avesitesi.xyz

# ───────────────────── Spring Profile ─────────────────────
SPRING_PROFILES_ACTIVE=prod

# ───────────────────── İlk admin kullanıcı (opsiyonel seed) ─────────────────────
# Boş bırakırsan ilk kurulumdan sonra el ile oluşturman gerekir.
GSCRM_INITIAL_ADMIN_USERNAME=admin
GSCRM_INITIAL_ADMIN_PASSWORD=change-me-on-first-login

# ───────────────────── Platform admin (davet kodu paneli) ─────────────────────
# Bu kullanıcı olmadan /platform/tenants açılamaz, dolayısıyla davet kodu
# üretilemez. Tanımlıysa kullanıcı oluşturulur ya da mevcut kullanıcı
# PLATFORM_ADMIN rolüne yükseltilir; ilk girişte parola değişimi zorunludur.
GSCRM_PLATFORM_ADMIN_USERNAME=platform
GSCRM_PLATFORM_ADMIN_PASSWORD=change-me-on-first-login
